# ─────────────────────────────────────────────────────────
# Pandanest.in Server Environment Variables
# Copy this file to server/.env and fill in all values.
# NEVER commit server/.env to git!
# ─────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# JWT Secret — CHANGE THIS IN PRODUCTION!
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_in_production

# PostgreSQL Database URL
# Local:   postgresql://postgres:password@localhost:5432/pandanest
# Aiven/Neon/Supabase: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pandanest

# Gmail SMTP — Required for OTP email login
# 1. Enable 2FA on your Google account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Google OAuth — Required for Google Sign-In button
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Cloudinary — Required for toy image uploads
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://pandanest.in

# Default Admin Account (created on first server startup)
# Change these before deploying!
ADMIN_EMAIL=admin@pandanest.in
ADMIN_PASSWORD=change_me_strong_password
ADMIN_NAME=Pandanest Store Manager
