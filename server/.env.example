# Server Environment Variables for Pandanest.in
PORT=5000
JWT_SECRET=pandanest_super_secret_jwt_key_2026_xyz

# PostgreSQL Database Configuration
# Examples:
# Local: postgresql://postgres:password@localhost:5432/pandanest
# Neon/Supabase/Render: postgresql://user:pass@ep-xyz.aws.neon.tech/pandanest?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pandanest

# Cloudinary Configuration for Toy Images
# Get these from your Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Admin Login credentials (Created on first startup)
ADMIN_EMAIL=admin@pandanest.in
ADMIN_PASSWORD=admin123
ADMIN_NAME=Pandanest Store Manager
